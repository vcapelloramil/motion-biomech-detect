.cache/

# --- Configuración local / secretos ---
# .env real: nunca va a git. El versionado es backend/.env.example
.env
.env.*
!.env.example

# --- Datos de video ---
# Los videos viven fuera del repo (~/kinetiq-data). Nunca se commitean.
# Ver docs/decisiones/002-config-ruta-corpus.md
*.mp4
*.mov
*.avi
*.mkv
*.m4v
kinetiq-data/

# --- Gestor de paquetes del frontend ---
# El proyecto usa bun (bun.lock). No mantener un segundo lockfile de npm.
package-lock.json

