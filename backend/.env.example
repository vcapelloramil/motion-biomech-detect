# Copiá este archivo a  backend/.env  y ajustá la ruta a tu máquina.
# backend/.env NO se versiona (está en .gitignore); este .example sí.

# Carpeta raíz del corpus de datos de video.
# Vive FUERA del repositorio (no se sube a git). Adentro se espera encontrar:
#   fase-a/segmentos/  fase-a/compilaciones/  fase-a/control/  fase-b/  catalogo.csv
#
# Se admite / o \ como separador en Windows. El ~ se expande al home del usuario.
KINETIQ_DATA_DIR=C:/Users/tu-usuario/kinetiq-data

# Opcional: carpeta para resultados intermedios del motor (coordenadas de pose
# extraídas, etc.). Si se omite, se usa backend/.cache/ (ignorada por git).
#KINETIQ_CACHE_DIR=C:/Users/tu-usuario/kinetiq-cache
