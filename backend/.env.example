# Copiá este archivo a  backend/.env  y ajustá la ruta a tu máquina.
# backend/.env NO se versiona (está en .gitignore); este .example sí.

# Carpeta raíz del corpus de datos de video.
# Vive FUERA del repositorio (no se sube a git). Adentro se espera encontrar:
#   fase-a/segmentos/  fase-a/compilaciones/  fase-a/control/  fase-b/  catalogo.csv
#
# Se admite / o \ como separador en Windows. El ~ se expande al home del usuario.
KINETIQ_DATA_DIR=C:/Users/tu-usuario/kinetiq-data

# Opcional: carpeta para resultados intermedios del motor (coordenadas de pose
# extraídas, etc.). Si se omite, se usa backend/.cache/ (ignorada por git).
#KINETIQ_CACHE_DIR=C:/Users/tu-usuario/kinetiq-cache

# --- Etapa 4.5: Supabase (esqueleto en la nube) ---------------------------------
# Panel de Supabase del proyecto -> Project Settings -> API.
#
# URL del proyecto (pública, no es secreta).
SUPABASE_URL=https://tu-proyecto.supabase.co
#
# Clave service_role (sección "Project API keys", botón "Reveal"). SECRETA: bypasea
# Row Level Security por diseño de Supabase. La usa el CONTENEDOR del motor para
# escribir resultados; nunca va al frontend ni a un entorno de Vercel. No pegarla
# en un chat ni en ningún lugar versionado — solo en este archivo (ignorado por
# git) o como variable de entorno del proveedor de contenedor.
SUPABASE_SERVICE_ROLE_KEY=
#
# Clave "anon" (pública, sección "Project API keys"; no es secreta, es la misma que
# usaría el frontend). Hace falta ANTES de lo previsto (decisión 018): la prueba de
# aislamiento de RLS (tests/integration/test_rls_aislamiento.py, tarea 4.5.1) se
# autentica como usuarios de prueba para verificar que no se ven datos ajenos, y
# necesita la clave anon para eso. La cadena de conexión directa de Postgres sigue
# sin hacer falta hasta las Etapas 6-8.
SUPABASE_ANON_KEY=

# --- Decisión 022: reintento de un video que falló ------------------------------------------------
# Opcional. Tope de intentos para reintentar un video que falló por un error inesperado (no por la
# declaración del modo de captura). 3 si no se define. Parámetro de operación, no un secreto.
#KINETIQ_MAX_INTENTOS=3

# --- Etapa 4.5.4: prueba contra el despliegue real en Render ---------------------
# Solo las usa tests/integration/test_render_modo_captura.py (se salta sin ellas).
#
# URL base del servicio en Render, sin barra final (p. ej. https://kinetiq-motor-xxxx.onrender.com).
KINETIQ_API_URL=
#
# (Desde la tarea 7.4 / decisión 025 ya NO hay token compartido: POST /analisis/{video_id}/procesar
# exige el JWT del usuario. La prueba se autentica con un usuario de prueba real creado por el
# propio test. KINETIQ_API_TOKEN se puede borrar del panel de Render.)

# --- Tarea 7.4: CORS ----------------------------------------------------------------------------------
# Orígenes del frontend que pueden llamar a la API, separados por comas, sin barra final y sin
# comodines. Sin valor, la API no acepta ningún origen de navegador. No es un secreto.
#KINETIQ_CORS_ORIGINS=https://kinetiq.pages.dev,http://localhost:5173
