# Copiá este archivo a  frontend/.env  (no se versiona) y completá los valores.
#
# SOLO valores PÚBLICOS: todo lo que empieza con VITE_ queda dentro del JavaScript que baja el navegador.
# NUNCA va acá la clave service_role de Supabase ni ningún secreto (decisión 025, CLAUDE.md §4.5).

# URL del proyecto Supabase (Project Settings -> API). Pública.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave "anon" / publishable del mismo panel. Pública por diseño: la protegen las políticas RLS.
VITE_SUPABASE_ANON_KEY=

# URL base de la API del motor en Render, sin barra final (p. ej. https://kinetiq-motor-xxxx.onrender.com).
# La usa la pantalla Cargar para disparar el análisis (POST /analisis/{id}/procesar con el JWT de la sesión).
VITE_API_URL=
